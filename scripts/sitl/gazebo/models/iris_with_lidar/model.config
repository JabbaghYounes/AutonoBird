<?xml version="1.0"?>
<model>
  <name>Iris with Forward Lidar</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    Wrapper around iris_with_gimbal (rotors + ArduPilotPlugin) with a
    forward-facing GPU lidar mounted on the iris base_link. Used by the
    AutonoBird T5 closed-loop avoidance test in Gazebo Harmonic. The
    gimbal itself is unused (left in place to avoid editing
    iris_with_gimbal's plugins).
  </description>
  <depend>
    <model>
      <uri>model://iris_with_standoffs</uri>
      <version>2.0</version>
    </model>
    <model>
      <uri>model://gimbal_small_2d</uri>
      <version>2.0</version>
    </model>
  </depend>
</model>

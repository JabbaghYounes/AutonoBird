# Per-subsystem virtualenvs / configs / runtime artefacts
config.json
venv/
voices/
__pycache__/

# Project meta — kept local (per global rules)
CLAUDE.md

# resources/ is default-deny with explicit carve-outs for publishable artefacts.
# Dissertation .docx, raw videos, third-party CAD/datasheets, and personal
# notes stay local; the items below ship with the repo.
resources/*
!resources/AutonoBird_MindMap.html
!resources/AutonoBird-Poster.html
!resources/params/
!resources/presentation/
!resources/pose_diagrams/

# Hailo NPU compiled models (binary, 5-20 MB each)
*.hef
hailort.log

# SITL + MAVProxy runtime logs (regenerable; commit specific evidence runs explicitly)
/scripts/sitl/*.txt
*.tlog
*.BIN
*.bin

# Gazebo top-down visualisations (regenerated by plot_room_top_down.py)
/scripts/sitl/gazebo/worlds/*_topdown.png
